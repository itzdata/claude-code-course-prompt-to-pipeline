{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "SF_CONNECTION": "itzdata",
    "SF_ROLE": "COFFEE_LAB_PARTICIPANT",
    "SF_WAREHOUSE": "COMPUTE_WH",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(python scripts/sf.py:*)",
      "Bash(python scripts/gen_demo_data.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Edit(participants/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Edit(standards/**)",
      "Edit(templates/**)",
      "Edit(setup/**)"
    ],
    "deny": [
      "Bash(snow sql:*)",
      "Bash(snowsql:*)",
      "Bash(snow connection:*)",
      "Read(./.env)",
      "Read(./**/*.token)",
      "Read(./.secrets/**)",
      "Read(~/.snowflake/**)",
      "Edit(setup/00_admin_setup.sql)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.py\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt_policy.py\"" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_sql.py\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint_sql.py\"" }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python \"$CLAUDE_PROJECT_DIR/.claude/statusline.py\""
  }
}
